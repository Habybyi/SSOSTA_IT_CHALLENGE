{
  "name": "custodia-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Backend API pre Custodia CRM (správa zákazníkov a servisu).",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:demo": "node prisma/demo.js",
    "test": "node --test test/*.test.js",
    "iot:simulate": "node scripts/iot-simulator.js",
    "start:render": "prisma migrate deploy && node prisma/seed.js && node prisma/demo.js && node src/index.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.6",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
