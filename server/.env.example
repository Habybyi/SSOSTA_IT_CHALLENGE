# Kam sa ukladajú nahrané fotky
UPLOAD_DIR=uploads

# E-maily (lokálne ich zachytí Mailpit: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Custodia <servis@custodia.sk>"
# Kam smeruje odkaz v e-mailoch pre tím
APP_URL=http://localhost:5173

# Tajný kľúč pre príjem e-mailov (webhook z e-mailovej služby, napr. Mailgun/SendGrid)
