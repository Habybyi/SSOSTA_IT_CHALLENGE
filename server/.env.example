PORT=3001
DATABASE_URL="postgresql://custodia:custodia@localhost:5433/custodia?schema=public"
# Vygeneruj vlastný: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=zmen-ma
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173

# Prvý účet majiteľa (vytvorí ho seed)
SEED_OWNER_EMAIL=milan.kovac@custodia.sk
SEED_OWNER_NAME="Milan Kováč"
