generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  TECHNICIAN
  CUSTOMER
}

model User {
  id                 String   @id @default(uuid()) @db.Uuid
  email              String   @unique
  name               String
  phone              String?
  passwordHash       String
  role               Role
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  customerId         String?  @unique @db.Uuid
  customer           Customer? @relation(fields: [customerId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  assignedRequests ServiceRequest[]      @relation("AssignedTechnician")
  createdRequests  ServiceRequest[]      @relation("CreatedBy")
  statusChanges    RequestStatusChange[]
  appointments     Appointment[]
  workLogs         WorkLog[]
  photos           Photo[]
  auditLogs        AuditLog[]
  notifications    Notification[]
}

enum CustomerStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum ContactChannel {
  PHONE
  EMAIL
  SMS
}

enum Source {
  WEB_FORM
  CALCULATOR
  EMAIL
  PHONE
  REFERRAL
  CUSTOMER_PORTAL
  MANUAL
  IOT
}

model Customer {
  id                String         @id @default(uuid()) @db.Uuid
  firstName         String
  lastName          String
  companyName       String?
  email             String?
  phone             String?
  phoneNormalized   String?
  preferredContact  ContactChannel @default(PHONE)
  status            CustomerStatus @default(ACTIVE)
  source            Source         @default(MANUAL)
  billingStreet     String?
  billingCity       String?
  billingPostalCode String?
  notes             String?
  marketingConsent  Boolean        @default(false)
  serviceReminders  Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  deletedAt         DateTime?

  user            User?
  gardens         Garden[]
  serviceRequests ServiceRequest[]
  notifications   Notification[]

  @@index([lastName, firstName])
  @@index([status])
  @@index([phoneNormalized])
  @@index([email])
}

enum WaterSource {
  MAINS
  WELL
  RAINWATER
  OTHER
}

model Garden {
  id                 String       @id @default(uuid()) @db.Uuid
  customerId         String       @db.Uuid
  customer           Customer     @relation(fields: [customerId], references: [id])
  label              String       @default("Hlavná záhrada")
  street             String
  city               String
  postalCode         String?
  latitude           Float?
  longitude          Float?
  areaM2             Int?
  waterSource        WaterSource  @default(MAINS)
  waterPressureBar   Decimal?     @db.Decimal(4, 2)
  flowRateLpm        Decimal?     @db.Decimal(6, 2)
  mainValveLocation  String?
  controllerModel    String?
  controllerLocation String?
  isSmartController  Boolean      @default(false)
  hasRainSensor      Boolean      @default(false)
  installedYear      Int?
  systemVersion      String?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  zones           Zone[]
  photos          Photo[]
  devices         Device[]
  serviceRequests ServiceRequest[]
  appointments    Appointment[]
  workLogs        WorkLog[]

  @@index([customerId])
  @@index([city])
}

enum ZoneArea {
  LAWN
  BED
  HEDGE
  OTHER
}

enum IrrigationType {
  SPRINKLER
  DRIP
}

model Zone {
  id             String         @id @default(uuid()) @db.Uuid
  gardenId       String         @db.Uuid
  garden         Garden         @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  number         Int
  name           String?
  areaType       ZoneArea       @default(LAWN)
  irrigationType IrrigationType @default(SPRINKLER)
  areaM2         Int?
  sprinklerType  String?
  sprinklerBrand String?
  sprinklerCount Int?
  valveType      String?
  valveLocation  String?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([gardenId, number])
}

model Photo {
  id               String          @id @default(uuid()) @db.Uuid
  storageKey       String
  mimeType         String
  sizeBytes        Int
  caption          String?
  gardenId         String?         @db.Uuid
  garden           Garden?         @relation(fields: [gardenId], references: [id])
  serviceRequestId String?         @db.Uuid
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  workLogId        String?         @db.Uuid
  workLog          WorkLog?        @relation(fields: [workLogId], references: [id])
  uploadedById     String?         @db.Uuid
  uploadedBy       User?           @relation(fields: [uploadedById], references: [id])
  createdAt        DateTime        @default(now())
}

enum DeviceType {
  HOME_GATEWAY
  SPRINKLER
  HUMIDITY_SENSOR
  WATER_LEVEL_SENSOR
  TRIP_SENSOR
  MOWER
  OTHER
}

model Device {
  id         String     @id @default(uuid()) @db.Uuid
  gardenId   String     @db.Uuid
  garden     Garden     @relation(fields: [gardenId], references: [id], onDelete: Cascade)
  type       DeviceType
  name       String
  externalId String?
  tokenHash  String?    @unique
  lastValue  Json?
  lastSeenAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  readings DeviceReading[]
}

model DeviceReading {
  id         String   @id @default(uuid()) @db.Uuid
  deviceId   String   @db.Uuid
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  value      Float
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
}

enum RequestType {
  FAULT
  SPRING_START
  WINTERIZATION
  LAWN_CARE
  INSTALLATION
  INSPECTION
  OTHER
}

enum RequestStatus {
  NEW
  SCHEDULED
  IN_PROGRESS
  DONE
  CLOSED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  EMERGENCY
}

model ServiceRequest {
  id           String        @id @default(uuid()) @db.Uuid
  number       Int           @unique @default(autoincrement())
  customerId   String        @db.Uuid
  customer     Customer      @relation(fields: [customerId], references: [id])
  gardenId     String?       @db.Uuid
  garden       Garden?       @relation(fields: [gardenId], references: [id])
  type         RequestType
  status       RequestStatus @default(NEW)
  priority     Priority      @default(NORMAL)
  source       Source        @default(MANUAL)
  title        String
  description  String?
  payload      Json?
  createdById  String?       @db.Uuid
  createdBy    User?         @relation("CreatedBy", fields: [createdById], references: [id])
  assignedToId String?       @db.Uuid
  assignedTo   User?         @relation("AssignedTechnician", fields: [assignedToId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  closedAt     DateTime?

  statusChanges RequestStatusChange[]
  appointments  Appointment[]
  workLogs      WorkLog[]
  photos        Photo[]

  @@index([status, priority])
  @@index([customerId])
}

model RequestStatusChange {
  id               String         @id @default(uuid()) @db.Uuid
  serviceRequestId String         @db.Uuid
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  fromStatus       RequestStatus?
  toStatus         RequestStatus
  note             String?
  changedById      String?        @db.Uuid
  changedBy        User?          @relation(fields: [changedById], references: [id])
  createdAt        DateTime       @default(now())
}

enum AppointmentStatus {
  RESERVED
  CONFIRMED
  DONE
  CANCELLED
}

model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  serviceRequestId String?           @db.Uuid
  serviceRequest   ServiceRequest?   @relation(fields: [serviceRequestId], references: [id])
  gardenId         String            @db.Uuid
  garden           Garden            @relation(fields: [gardenId], references: [id])
  technicianId     String?           @db.Uuid
  technician       User?             @relation(fields: [technicianId], references: [id])
  startsAt         DateTime
  endsAt           DateTime
  status           AppointmentStatus @default(CONFIRMED)
  routeOrder       Int?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workLog WorkLog?

  @@index([startsAt])
  @@index([technicianId, startsAt])
}

model DayCapacity {
  date      DateTime @id @db.Date
  maxVisits Int
  note      String?
}

model Material {
  id         String   @id @default(uuid()) @db.Uuid
  sku        String?  @unique
  name       String
  unit       String   @default("ks")
  unitPrice  Decimal  @default(0) @db.Decimal(10, 2)
  stockQty   Decimal  @default(0) @db.Decimal(10, 2)
  minStock   Decimal  @default(0) @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  templates MaterialTemplate[]
  usages    WorkLogMaterial[]
}

model MaterialTemplate {
  id          String      @id @default(uuid()) @db.Uuid
  requestType RequestType
  materialId  String      @db.Uuid
  material    Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity    Decimal     @db.Decimal(10, 2)
  perZone     Boolean     @default(false)

  @@unique([requestType, materialId])
}

model WorkLog {
  id               String          @id @default(uuid()) @db.Uuid
  appointmentId    String?         @unique @db.Uuid
  appointment      Appointment?    @relation(fields: [appointmentId], references: [id])
  serviceRequestId String?         @db.Uuid
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  gardenId         String          @db.Uuid
  garden           Garden          @relation(fields: [gardenId], references: [id])
  technicianId     String?         @db.Uuid
  technician       User?           @relation(fields: [technicianId], references: [id])
  performedAt      DateTime        @default(now())
  durationMin      Int?
  description      String
  createdAt        DateTime        @default(now())

  materials WorkLogMaterial[]
  photos    Photo[]

  @@index([gardenId, performedAt])
}

model WorkLogMaterial {
  id         String   @id @default(uuid()) @db.Uuid
  workLogId  String   @db.Uuid
  workLog    WorkLog  @relation(fields: [workLogId], references: [id], onDelete: Cascade)
  materialId String   @db.Uuid
  material   Material @relation(fields: [materialId], references: [id])
  quantity   Decimal  @db.Decimal(10, 2)
  unitPrice  Decimal  @db.Decimal(10, 2)
}

enum NotificationChannel {
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

model Notification {
  id           String              @id @default(uuid()) @db.Uuid
  channel      NotificationChannel @default(EMAIL)
  recipient    String
  template     String
  payload      Json?
  status       NotificationStatus  @default(PENDING)
  scheduledFor DateTime            @default(now())
  sentAt       DateTime?
  attempts     Int                 @default(0)
  lastError    String?
  dedupeKey    String?             @unique
  customerId   String?             @db.Uuid
  customer     Customer?           @relation(fields: [customerId], references: [id])
  userId       String?             @db.Uuid
  user         User?               @relation(fields: [userId], references: [id])
  createdAt    DateTime            @default(now())

  @@index([status, scheduledFor])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model WebEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  source    String
  createdAt DateTime @default(now())

  @@index([createdAt, type])
}
